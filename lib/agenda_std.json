        {
          "id": "go_home",
          "when": {
            "cond": "far_from_home"
          },
          "goal": {
            "do": "return"
          }
        },
        {
          "id": "patrol",
          "when": true,
          "goal": {
            "do": "patrol",
            "radius": 5
          }
        }
      ]
    },
    "quest_giver": {
      "description": "Has work for strangers: tells the open quest, thanks and rewards when the stranger carries what was asked.",
