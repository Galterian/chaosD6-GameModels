          "when": {
            "and": [
              {
                "cond": "stranger_seen"
              },
              {
                "cond": "quest_open"
              },
              {
                "<=": [
                  {
                    "var": "stranger.dist"
                  },
                  {
                    "var": "params.beckon"
                  }
                ]
              },
              {
                "!": {
                  "cond": "stranger_hostile"
                }
              }
            ]
          },
          "goal": {
            "do": "approach",
            "target": "stranger",
            "stop": 2
          }
        },
        {
          "id": "go_home",
          "when": {
            "cond": "far_from_home"
          },
          "goal": {
            "do": "return"
          }
        },
        {
          "id": "idle",
          "when": true,
          "goal": {
            "do": "wander",
            "radius": 1
          }
        }
      ]
    },
