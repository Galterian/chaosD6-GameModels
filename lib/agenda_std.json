{
  "schema": "chaosd6.agenda-lib/1",
  "id": "agenda_std",
  "name": "Standard agendas",
  "description": "Named JsonLogic conditions ({\"cond\": id}) and the role agendas villagers, wanderers and monsters extend. An agenda is an ordered rule list: the first rule whose `when` holds gives the unit its goal for this action.",
  "conditions": {
    "hurt": {
      "<=": [
        {
          "*": [
            {
              "var": "me.life"
            },
            2
          ]
        },
        {
          "var": "me.life_max"
        }
      ]
    },
    "foe_seen": {
      "!!": [
        {
          "var": "foe"
        }
      ]
    },
    "foe_near": {
      "and": [
        {
          "!!": [
            {
              "var": "foe"
            }
          ]
        },
        {
          "<=": [
            {
              "var": "foe.dist"
            },
            {
              "var": "params.alert"
            }
          ]
        }
      ]
    },
    "foe_adjacent": {
      "and": [
        {
          "!!": [
            {
              "var": "foe"
            }
          ]
        },
        {
          "<=": [
            {
              "var": "foe.dist"
            },
            1
          ]
        }
      ]
    },
    "stranger_seen": {
      "!!": [
        {
          "var": "stranger"
        }
      ]
    },
    "stranger_close": {
      "and": [
        {
          "!!": [
            {
              "var": "stranger"
            }
          ]
        },
        {
          "<=": [
            {
              "var": "stranger.dist"
            },
            {
              "var": "params.talk"
            }
          ]
        }
      ]
    },
    "stranger_hostile": {
      "and": [
        {
          "!!": [
            {
              "var": "stranger"
            }
          ]
        },
        {
          "<": [
            {
              "var": "stranger.rep"
            },
            {
              "var": "village.rep.hostile"
            }
          ]
        }
      ]
    },
    "stranger_friend": {
      "and": [
        {
          "!!": [
            {
              "var": "stranger"
            }
          ]
        },
        {
          ">=": [
            {
              "var": "stranger.rep"
            },
            {
              "var": "village.rep.ally_all"
            }
          ]
        }
      ]
    },
    "stranger_welcome": {
      "and": [
        {
          "!!": [
            {
              "var": "stranger"
            }
          ]
        },
        {
          ">=": [
            {
              "var": "stranger.rep"
            },
            {
              "var": "village.rep.enter"
            }
          ]
        }
      ]
    },
    "trespasser": {
      "and": [
        {
          "!!": [
            {
              "var": "stranger"
            }
          ]
        },
        {
          "<=": [
            {
              "var": "stranger.dist_village"
            },
            {
              "var": "village.radius"
            }
          ]
        },
        {
          "<": [
            {
              "var": "stranger.rep"
            },
            {
              "var": "village.rep.enter"
            }
          ]
        }
      ]
    },
    "quest_open": {
      "and": [
        {
          "!!": [
            {
              "var": "stranger"
            }
          ]
        },
        {
          ">": [
            {
              "var": "stranger.quests_open"
            },
            0
          ]
        }
      ]
    },
    "quest_ready": {
      "and": [
        {
          "!!": [
            {
              "var": "stranger"
            }
          ]
        },
        {
          ">": [
            {
              "var": "stranger.quests_ready"
            },
            0
          ]
        }
      ]
    },
    "far_from_home": {
      ">": [
        {
          "var": "me.dist_home"
        },
        {
          "var": "params.leash"
        }
      ]
    },
    "alarm": {
      "!!": [
        {
          "var": "village.alarm"
        }
      ]
    },
    "friend_hurt": {
      "and": [
        {
          "!!": [
            {
              "var": "friend"
            }
          ]
        },
        {
          "<=": [
            {
              "*": [
                {
                  "var": "friend.life"
                },
                2
              ]
            },
            {
              "var": "friend.life_max"
            }
          ]
        },
        {
          "<=": [
            {
              "var": "friend.dist"
            },
            3
          ]
        }
      ]
    },
    "village_at_cap": {
      ">=": [
        {
          "var": "village.units"
        },
        {
          "var": "village.cap"
        }
      ]
    },
    "foe_at_war": {
      "and": [
        {
          "!!": [
            {
              "var": "foe"
            }
          ]
        },
        {
          "==": [
            {
              "var": "foe.war"
            },
            1
          ]
        }
      ]
    }
  },
  "agendas": {
    "villager": {
      "description": "Lives in the village: answers an attack, keeps close to home, greets visitors.",
      "params": {
        "alert": 3,
        "leash": 4,
        "talk": 2
      },
      "rules": [
        {
          "id": "war_flee",
          "when": {
            "and": [
              {
                "cond": "foe_at_war"
              },
              {
                "cond": "foe_near"
              }
            ]
          },
          "goal": {
            "do": "flee",
            "from": "foe"
          }
        },
        {
          "id": "flee_hurt",
          "when": {
            "and": [
              {
                "cond": "hurt"
              },
              {
                "cond": "foe_near"
              }
            ]
          },
          "goal": {
            "do": "flee",
            "from": "foe"
          }
        },
        {
          "id": "fight_back",
          "when": {
            "and": [
              {
                "cond": "foe_adjacent"
              },
              {
                "or": [
                  {
                    "cond": "alarm"
                  },
                  {
                    "cond": "stranger_hostile"
                  }
                ]
              }
            ]
          },
          "goal": {
            "do": "attack",
            "target": "foe"
          }
        },
        {
          "id": "go_home",
          "when": {
            "cond": "far_from_home"
          },
          "goal": {
            "do": "return"
          }
        },
        {
          "id": "greet",
          "when": {
            "and": [
              {
                "cond": "stranger_close"
              },
              {
                "!": {
                  "cond": "stranger_hostile"
                }
              }
            ]
          },
          "goal": {
            "do": "talk",
            "say": "greet",
            "target": "stranger"
          }
        },
        {
          "id": "idle",
          "when": true,
          "goal": {
            "do": "wander",
            "radius": 2
          }
        }
      ]
    },
    "guard": {
      "description": "Village soldier: turns out against trespassers and raiders, never leaves the village for long.",
      "params": {
        "alert": 5,
        "leash": 7,
