    "gate_guard": {
      "description": "Holds the village gate: stands right outside it, steps onto the gate to bar a stranger the village does not welcome yet, and steps back for a welcome one. Fights raiders like any guard.",
      "params": {
        "alert": 8,
        "leash": 3,
