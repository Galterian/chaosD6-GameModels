  "home": "bld_empire_quartermaster",
  "persona": "A scarred sword-for-hire who drinks at the barracks; loyal to friends of the village, and to nobody else.",
  "lines": {
    "greet": [
      "Looking for a blade?",
      "Hm. You have the look of trouble. I like trouble."
    ],
    "warn": [
      "Walk on, stranger."
    ]
  },
  "talk": [
    {
      "id": "battles",
      "ask": "Tell me of your battles.",
      "say": [
        "Three winters on the orc border. I came back; most did not. That is the whole story.",
        "I once held a bridge against a minotaur for an hour. The bridge did not survive. I did."
      ]
    },
    {
      "id": "price",
      "ask": "What is your price?",
      "say": [
        "Gold? No. The village's trust. Earn it, and my sword is yours.",
        "Win the village's trust and I follow you anywhere. Lose it and I will be the one hunting you."
      ]
    }
  ],
  "agenda": {
