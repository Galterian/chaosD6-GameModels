  "name": "Moon Envoy",
  "version": "1.0.0",
  "race": "race_high_elves",
  "role": "diplomat",
  "home": "bld_high_elves_ministry",
  "persona": "Speaks for the village to the other peoples: knows the roads, and who stands with whom. For a price, also what they whisper.",
  "lines": {
    "greet": [
      "Peace be with you — and with your people.",
      "News of the other villages? Ask me."
    ],
    "quest": [
      "For {need} I go where you lead me — and they will not like what I leave behind."
    ],
    "thanks": [
      "Our secret, then. Lead me to them."
    ],
    "warn": [
      "I do not travel with enemies of my village."
    ]
  },
  "talk": [
    {
      "id": "envoys",
      "ask": "What does a diplomat do?",
      "say": [
        "I speak for my village to the other peoples. Walk me to one of them and I stay there as our envoy: both villages think better of each other — and of you.",
        "Villages that think less than forty in a hundred of each other are at war; their fighters fall on each other wherever they meet. Peace is my trade, in the name of the Tree of Gold."
      ]
    }
  ],
  "agenda": {
    "uses": "diplomat",
    "params": {
      "beckon": 8
    },
