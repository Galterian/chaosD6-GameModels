            {
              "cond": "stranger_seen"
            },
            {
              "!": {
                "cond": "stranger_hostile"
              }
            },
            {
              "!": {
                "cond": "foe_near"
              }
            },
            {
              "!": {
                "cond": "far_from_home"
              }
            },
            {
              "<=": [
                {
                  "var": "stranger.dist"
                },
                {
                  "var": "params.beckon"
                }
              ]
            },
            {
              ">": [
                {
                  "var": "stranger.dist"
                },
                {
                  "var": "params.talk"
                }
              ]
            }
          ]
        },
        "goal": {
          "do": "approach",
          "target": "stranger",
          "stop": 2
        }
      }
    ]
  },
  "quests": [
