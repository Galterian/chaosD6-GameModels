  "home": "bld_fey_shop",
  "persona": "A haggler with a cart full of oddments; barters cards for cards and never says what anything is worth.",
  "lines": {
    "greet": [
      "Everything has a price, friend!",
      "Come, see what the road brought me."
    ],
    "quest": [
      "Give me {need} and you shall have {reward}. A bargain!"
    ],
    "thanks": [
      "Pleasure doing business! {reward}"
    ],
    "warn": [
      "No credit, no haggling with thieves."
    ]
  },
  "talk": [
    {
      "id": "rumours",
      "ask": "Heard any rumours?",
      "say": [
        "They say the Fey pay well for Invisibility. They say a lot of things.",
        "A merchant swore he saw a dragon over the hills. He also swore his prices were fair."
      ]
    }
  ],
  "agenda": {
    "uses": "villager",
    "params": {
      "beckon": 7,
      "leash": 6
    },
    "rules": [
